# =====================================================================
# 범용 .gitignore
# 필요 없는 섹션은 지우고, 프로젝트에 맞게 아래 "프로젝트 전용"을 채우세요.
# 이미 커밋된 파일은 여기 추가해도 계속 추적됩니다.
#   → git rm --cached <파일> 로 추적을 끊어야 합니다.
# =====================================================================


# ---------------------------------------------------------------------
# 비밀 정보 (가장 중요: 절대 올리면 안 되는 것)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials*.json
service-account*.json
.netrc


# ---------------------------------------------------------------------
# 운영체제
# ---------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*


# ---------------------------------------------------------------------
# 에디터 / IDE
# ---------------------------------------------------------------------
# VS Code (팀이 공유할 설정 파일만 남김)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ 등)
.idea/
*.iml

# Vim / Emacs / Sublime
*.swp
*.swo
*.un~
\#*\#
.\#*
*.sublime-workspace


# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# 가상환경
.venv/
venv/
env/
ENV/
.conda/

# 패키징 / 빌드
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# 테스트 / 정적 분석 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml


# ---------------------------------------------------------------------
# Jupyter Notebook
# ---------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*


# ---------------------------------------------------------------------
# 머신러닝 / 데이터 산출물 (용량이 크고 재생성 가능한 것)
# ---------------------------------------------------------------------
# 학습된 모델 / 체크포인트
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx
*.pkl
*.joblib
checkpoints/
saved_models/

# 실험 기록
runs/
mlruns/
wandb/
lightning_logs/
outputs/

# 대용량 배열 / 캐시
*.npy
*.npz
*.parquet
.cache/


# ---------------------------------------------------------------------
# Node.js (웹 프론트엔드를 같이 쓸 때)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
.nuxt/
.parcel-cache/
coverage/


# ---------------------------------------------------------------------
# Java / Kotlin / Android (필요할 때만)
# ---------------------------------------------------------------------
*.class
target/
.gradle/
local.properties


# ---------------------------------------------------------------------
# 로그 / 임시 파일
# ---------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig


# ---------------------------------------------------------------------
# 압축 파일 (배포용 압축을 커밋해야 하면 이 섹션을 지우세요)
# ---------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar


# =====================================================================
# 프로젝트 전용
# =====================================================================
# 엘리스 교육 과정 제공 데이터 (저작권 자료: 외부 공개 금지)
dataset/
data/raw/
SKHY_*.txt

# 원본 과정 노트북을 그대로 둘 경우 (직접 작성한 노트북만 올리기)
# original_notebooks/